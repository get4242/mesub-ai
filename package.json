{
  "name": "mesub-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "db:guard:dev": "node scripts/assert-supabase-development.mjs",
    "db:link:dev": "pnpm db:guard:dev && supabase link --project-ref %SUPABASE_DEV_PROJECT_REF%",
    "db:push:dev": "pnpm db:guard:dev && supabase db push --linked",
    "db:test:dev": "pnpm db:guard:dev && supabase db query --linked --file supabase/tests/phase0_identity_tenancy_rls_test.sql",
    "db:test:integration:dev": "pnpm db:guard:dev && node scripts/verify-phase0-cloud.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
