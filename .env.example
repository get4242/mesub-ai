# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-or-anon-key

# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-development-secret-or-service-role-key
OPENAI_API_KEY=replace-with-openai-key
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token

# Task-based model profiles. Exact model IDs are selected after evaluation.
OPENAI_MODEL_EXTRACTION=replace-after-evaluation
OPENAI_MODEL_VISION=replace-after-evaluation
OPENAI_MODEL_LINE_CONVERSATION=replace-after-evaluation
OPENAI_MODEL_CONTENT=replace-after-evaluation
OPENAI_MODEL_FALLBACK=replace-after-evaluation

# Operational configuration
APP_ENV=development
APP_REGION=sin1
LOG_LEVEL=info

# Phase 0/1 Cloud verification only. Put real values in .env.cloud-test or the shell,
# never in this tracked example file. The guard refuses non-development targets.
SUPABASE_TARGET_ENV=development
SUPABASE_DEV_PROJECT_REF=your-development-project-ref
# Optional additional guard when this organization also has a Production Project.
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token
SUPABASE_DB_PASSWORD=replace-with-development-database-password
SUPABASE_DEV_URL=https://your-development-project-ref.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=replace-with-development-publishable-or-anon-key
SUPABASE_DEV_SECRET_KEY=replace-with-development-secret-or-service-role-key
