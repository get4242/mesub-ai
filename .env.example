# Runtime tier: local | preview | staging | production.
APP_ENV=local

# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key
OPENAI_API_KEY=replace-with-openai-key
WORKER_TRIGGER_SECRET=replace-with-at-least-32-random-characters

# LINE active runtime contract.
LINE_ENVIRONMENT=development
LINE_PROVIDER_ID=replace-with-provider-id
LINE_LOGIN_CHANNEL_ID=replace-with-login-channel-id
LINE_MINI_APP_LIFF_ID=replace-with-liff-id
LINE_MESSAGING_CHANNEL_SECRET=replace-with-messaging-channel-secret
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=replace-with-messaging-channel-access-token
LINE_IDENTITY_HASH_KEY=replace-with-at-least-16-random-characters
LINE_DESTINATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Required in Production to reject reuse of Development LINE identifiers.
LINE_DEVELOPMENT_PROVIDER_ID=
LINE_DEVELOPMENT_LOGIN_CHANNEL_ID=
LINE_DEVELOPMENT_MINI_APP_LIFF_ID=

# Task-based model profiles. Exact model IDs are selected after evaluation.
OPENAI_MODEL_EXTRACTION=replace-after-evaluation
OPENAI_MODEL_VISION=replace-after-evaluation
OPENAI_MODEL_LINE_CONVERSATION=replace-after-evaluation
OPENAI_MODEL_CONTENT=replace-after-evaluation
OPENAI_MODEL_FALLBACK=replace-after-evaluation

# Operational configuration
APP_REGION=sin1
LOG_LEVEL=info
AI_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=3
AI_MAX_TEXT_CHARACTERS=12000
AI_MAX_IMAGES=10
AI_MAX_CONTENT_CHARACTERS=5000

# Production audit authentication. The promoted project identity is pinned in
# supabase/project-role.json. db:audit:production performs SELECT-only checks.
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token

# Development mutation/regression credentials are usable only with a future
# non-Production sandbox whose ref differs from the promoted project marker.
# Never point these values at the promoted Production project.
SUPABASE_TARGET_ENV=development
SUPABASE_DEV_PROJECT_REF=your-future-development-project-ref
SUPABASE_PRODUCTION_PROJECT_REF=ptfhybowvtywyyidcswu
SUPABASE_DB_PASSWORD=replace-with-development-database-password
SUPABASE_DEV_URL=https://your-future-development-project-ref.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=replace-with-development-publishable-or-anon-key
SUPABASE_DEV_SECRET_KEY=replace-with-development-secret-or-service-role-key
