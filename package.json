{
  "name": "mesub-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "db:guard:dev": "node --env-file=.env.cloud-test scripts/assert-supabase-development.mjs",
    "db:audit:production": "node scripts/run-production-audit.mjs",
    "db:link:dev": "pnpm db:guard:dev && supabase link --project-ref %SUPABASE_DEV_PROJECT_REF%",
    "db:push:dev": "pnpm db:guard:dev && supabase db push --linked",
    "db:test:dev": "pnpm db:guard:dev && supabase db query --linked --file supabase/tests/phase0_identity_tenancy_rls_test.sql",
    "db:test:integration:dev": "pnpm db:guard:dev && node scripts/verify-phase0-cloud.mjs",
    "db:test:phase1:dev": "node --env-file=.env.cloud-test scripts/run-phase1-pgtap.mjs",
    "db:test:integration:phase1:dev": "node --env-file=.env.cloud-test scripts/verify-phase1-cloud.mjs"
    ,"db:test:phase2:dev": "node --env-file=.env.cloud-test scripts/run-phase2-pgtap.mjs"
    ,"db:test:integration:phase2:dev": "node --env-file=.env.cloud-test scripts/verify-phase2-cloud.mjs"
    ,"db:test:phase3:dev": "node --env-file=.env.cloud-test scripts/run-phase3-pgtap.mjs"
    ,"db:test:integration:phase3:dev": "node --env-file=.env.cloud-test scripts/verify-phase3-cloud.mjs"
    ,"db:test:phase4:dev": "node --env-file=.env.cloud-test scripts/run-phase4-pgtap.mjs"
    ,"db:test:integration:phase4:dev": "node --env-file=.env.cloud-test scripts/verify-phase4-cloud.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "openai": "7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
